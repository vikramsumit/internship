<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="saltlake.net.xml"/>
    <route-files value="traffic_sorted.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="900"/>
    <step-length value="1"/>
  </time>
  <processing>
    <time-to-teleport value="-1"/>
  </processing>
  <report>
    <no-step-log value="true"/>
  </report>
</configuration>
